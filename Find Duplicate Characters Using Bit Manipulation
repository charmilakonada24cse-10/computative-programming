s = input().strip()
seen = 0
duplicates = 0
for ch in s:
    bit = 1 << (ord(ch) - ord('a'))
    if seen & bit:
        duplicates |= bit
    else:
        seen |= bit
printed = 0
for ch in s:
    bit = 1 << (ord(ch) - ord('a'))
    if (duplicates & bit) and not (printed & bit):
        print(ch, end=" ")
        printed |= bit
if duplicates == 0:
    print("No duplicates")

