s = input().strip()
n = len(s)
# Build LPS array
lps = [0] * n
j = 0
i = 1
while i < n:
    if s[i] == s[j]:
        j += 1
        lps[i] = j
        i += 1
    elif j != 0:
        j = lps[j - 1]
    else:
        lps[i] = 0
        i += 1
period = n - lps[-1]
if n % period == 0:
    print(period)
else:
    print(n)

